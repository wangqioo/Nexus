## Floyd-Steinberg 抖动 (墨水屏)

**来源**: `/Users/wq/InkTime/render_daily_photo.py`

```python
from PIL import Image

PALETTE = [
    (0, 0, 0),         # 黑
    (255, 255, 255),   # 白
    (200, 0, 0),       # 红
    (220, 180, 0),     # 黄
    (0, 180, 0),       # 绿
    (0, 0, 200),       # 蓝
]

def nearest_color(r, g, b):
    min_dist = float('inf')
    best = 0
    for i, (pr, pg, pb) in enumerate(PALETTE):
        dist = (r-pr)**2 + (g-pg)**2 + (b-pb)**2
        if dist < min_dist:
            min_dist, best = dist, i
    return best, PALETTE[best]

def floyd_steinberg_dither(img: Image.Image) -> Image.Image:
    img = img.convert('RGB')
    pixels = img.load()
    w, h = img.size
    
    for y in range(h):
        for x in range(w):
            old_r, old_g, old_b = pixels[x, y]
            idx, (new_r, new_g, new_b) = nearest_color(old_r, old_g, old_b)
            pixels[x, y] = (new_r, new_g, new_b)
            
            # 误差
            err_r, err_g, err_b = old_r - new_r, old_g - new_g, old_b - new_b
            
            # 扩散 (7/16, 3/16, 5/16, 1/16)
            for dx, dy, f in [(1,0,7/16), (-1,1,3/16), (0,1,5/16), (1,1,1/16)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    pr, pg, pb = pixels[nx, ny]
                    pixels[nx, ny] = (
                        max(0, min(255, int(pr + err_r * f))),
                        max(0, min(255, int(pg + err_g * f))),
                        max(0, min(255, int(pb + err_b * f)))
                    )
    return img
```

