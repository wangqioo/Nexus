## WS2812 LED 矩阵

**来源**: `/Users/wq/flickering_candlelight/esp32s3_dual_effect/main/ws2812_matrix.c`

### 初始化 (ESP-IDF RMT)

```c
#include "led_strip.h"

static led_strip_handle_t led_strip = NULL;

esp_err_t matrix_init(void) {
    led_strip_config_t strip_config = {
        .strip_gpio_num = GPIO_NUM_14,      // 数据引脚
        .max_leds = 64,                      // 8x8 = 64
        .led_pixel_format = LED_PIXEL_FORMAT_GRB,
        .led_model = LED_MODEL_WS2812,
    };
    
    led_strip_rmt_config_t rmt_config = {
        .clk_src = RMT_CLK_SRC_DEFAULT,
        .resolution_hz = 10 * 1000 * 1000,  // 10MHz
    };
    
    ESP_ERROR_CHECK(led_strip_new_rmt_device(&strip_config, &rmt_config, &led_strip));
    return ESP_OK;
}
```

### 设置像素颜色

```c
void matrix_set_pixel(uint8_t row, uint8_t col, uint8_t r, uint8_t g, uint8_t b) {
    int index = row * 8 + col;
    // WS2812 是 GRB 格式，但 led_strip API 已处理
    led_strip_set_pixel(led_strip, index, r, g, b);
}

esp_err_t matrix_refresh(void) {
    return led_strip_refresh(led_strip);
}
```

