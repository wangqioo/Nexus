## QMI8658 IMU 传感器

**来源**: `/Users/wq/flickering_candlelight/esp32s3_dual_effect/main/qmi8658.c`

### I2C 初始化

```c
#include "driver/i2c.h"

#define QMI8658_ADDR    0x6B
#define I2C_SDA         GPIO_NUM_11
#define I2C_SCL         GPIO_NUM_12

esp_err_t qmi8658_init(void) {
    i2c_config_t conf = {
        .mode = I2C_MODE_MASTER,
        .sda_io_num = I2C_SDA,
        .scl_io_num = I2C_SCL,
        .sda_pullup_en = GPIO_PULLUP_ENABLE,
        .scl_pullup_en = GPIO_PULLUP_ENABLE,
        .master.clk_speed = 400000,  // 400kHz
    };
    ESP_ERROR_CHECK(i2c_param_config(I2C_NUM_0, &conf));
    ESP_ERROR_CHECK(i2c_driver_install(I2C_NUM_0, I2C_MODE_MASTER, 0, 0, 0));
    
    // 软复位
    qmi8658_write_reg(0x60, 0xB0);
    vTaskDelay(pdMS_TO_TICKS(20));
    
    // 配置加速度计: 4G 量程, 1000Hz
    qmi8658_write_reg(0x03, 0x25);  // CTRL2
    // 使能传感器
    qmi8658_write_reg(0x08, 0x03);  // CTRL7
    
    return ESP_OK;
}
```

### 读取加速度

```c
esp_err_t qmi8658_read_accel(float *x, float *y, float *z) {
    uint8_t raw[6];
    qmi8658_read_reg(0x35, raw, 6);  // AX_L 起始地址
    
    int16_t ax = (raw[1] << 8) | raw[0];
    int16_t ay = (raw[3] << 8) | raw[2];
    int16_t az = (raw[5] << 8) | raw[4];
    
    // 4G 量程: 8192 LSB/g
    *x = ax / 8192.0f;
    *y = ay / 8192.0f;
    *z = az / 8192.0f;
    return ESP_OK;
}
```

