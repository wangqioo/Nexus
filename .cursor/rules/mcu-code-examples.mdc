## 火焰效果算法

**来源**: `/Users/wq/flickering_candlelight/esp32s3_dual_effect/main/candle_effect.c`

```c
#define FIRE_WIDTH  8
#define FIRE_HEIGHT 10
static uint8_t fire_buffer[FIRE_HEIGHT][FIRE_WIDTH];

void candle_update(float tilt_x) {
    // 1. 底部热源 (烛芯位置)
    for (int x = 0; x < FIRE_WIDTH; x++) {
        if (x >= 2 && x <= 5) {  // 中间区域
            fire_buffer[FIRE_HEIGHT-1][x] = 220 + (esp_random() % 35);
        }
    }
    
    // 2. 热量向上传播 + 衰减
    for (int y = 0; y < FIRE_HEIGHT - 2; y++) {
        for (int x = 0; x < FIRE_WIDTH; x++) {
            int offset_x = x + (int)(tilt_x * 1.2f);  // IMU 倾斜影响
            if (offset_x < 0) offset_x = 0;
            if (offset_x >= FIRE_WIDTH) offset_x = FIRE_WIDTH - 1;
            
            int heat = fire_buffer[y+1][offset_x];
            int decay = 12 + (y * 5);
            int flicker = (esp_random() % 30) - 15;
            
            fire_buffer[y][x] = MAX(0, heat - decay + flicker);
        }
    }
    
    // 3. 映射到 LED
    for (int y = 0; y < 8; y++) {
        for (int x = 0; x < 8; x++) {
            uint8_t heat = fire_buffer[FIRE_HEIGHT - 1 - y][x];
            matrix_set_pixel_brightness(y, x, heat);
        }
    }
    matrix_refresh();
}
```

