  "4_flame_effect_algorithm": {
    "description": "基于热量扩散的实时火焰模拟算法",
    "source_files": ["candle_effect.c", "candle_effect.h"],
    "algorithm_steps": [
      "1. 底部热源：8x10火焰缓冲区(FIRE_HEIGHT=10)，底部2行为热源",
      "2. 热源分布：烛芯(列3-4)较暗形成空心，列2/5最亮，列1/6中等，列0/7无热",
      "3. 热量传播：自下而上，取下方/左下/右下的平均热量",
      "4. 衰减公式：decay = 12 + (y * 5)，高度越高衰减越大",
      "5. 随机闪烁：flicker = (random % 30) - 15",
      "6. 新热量：new_heat = avg_heat - decay + flicker",
      "7. 温度映射：heat值(0-255)通过matrix_set_pixel_brightness转为暖色调"
    ],
    "key_code_snippets": {
      "heat_source_layout": "// 烛芯外围(2和5列)热量最高\nif (x == 2 || x == 5) {\n  fire_buffer[FIRE_HEIGHT-1][x] = 220 + (esp_random() % 35);\n  fire_buffer[FIRE_HEIGHT-2][x] = 200 + (esp_random() % 55);\n}",
      "heat_propagation": "// 正下方+下方两格+左下右下\nheat_sum += fire_buffer[y+1][x] + fire_buffer[y+2][x];\nif (x>0) heat_sum += fire_buffer[y+1][x-1];\nif (x<7) heat_sum += fire_buffer[y+1][x+1];\navg_heat = heat_sum / heat_count;",
      "decay_and_flicker": "int decay = 12 + (y * 5);\nint flicker = (esp_random() % 30) - 15;\nint new_heat = avg_heat - decay + flicker;",
      "tilt_offset_imu": "// candlelight_imu 版本：倾斜时火焰偏移\nint offset = (int)(tilt_x * 2.0f);  // tilt_x: -1.0~1.0\nint offset_x = x + offset;\nheat_sum += fire_buffer[y+1][offset_x];"
    },
    "color_mapping": {
      "function": "matrix_set_pixel_brightness() in ws2812_matrix.c",
      "logic": "brightness(0-255) -> 暖色调: g=255, r=brightness*180, b=0 (GRB格式需交换)",
      "palette": "暗红 -> 橙红 -> 黄橙"
    }
  },
