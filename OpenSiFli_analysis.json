{
  "project_name": "OpenSiFli",
  "analysis_date": "2025-02-13",
  "summary": "OpenSiFli 为 SiFli 芯片 SoC 的嵌入式 SDK，基于 RT-Thread，支持多款 SF32LB 系列芯片，提供 LVGL 手表等示例应用",

  "1_chip_and_framework": {
    "chips": [
      {
        "name": "SF32LB52X",
        "cpu": "Cortex-M33",
        "description": "入门级，支持 LCHSPI LCD、N16R8 等配置"
      },
      {
        "name": "SF32LB55X",
        "packages": ["SF32LB555_A3", "SF32LB551_A3"],
        "description": "中端，立方体旋转界面不支持"
      },
      {
        "name": "SF32LB56X",
        "description": "中高端，支持 NAND/SDIO 等"
      },
      {
        "name": "SF32LB58X",
        "packages": ["SF32LB587"],
        "description": "高端，支持 DSI/DPI/QSPI LCD、大 PSRAM"
      }
    ],
    "cpu_cores": ["HCPU", "LCPU", "ACPU"],
    "framework": {
      "primary": "RT-Thread",
      "alternatives": ["No RTOS", "FreeRTOS"],
      "rtos_config": "BSP_USING_RTTHREAD (default)"
    },
    "memory_layout_example": {
      "RAM_BASE": "0x20000000",
      "RAM_SIZE": "0x0007FC00",
      "PSRAM_BASE": "0x60000000",
      "PSRAM_SIZE": "0x00800000",
      "ROM_BASE": "0x12020000",
      "ROM_SIZE": "0x00800000"
    }
  },

  "2_peripherals": {
    "rt_device_drivers": [
      "RT_USING_SERIAL (UART, 默认 DMA, 1M baudrate)",
      "RT_USING_I2C (支持 I2C_BITOPS 软件模拟)",
      "RT_USING_SPI (QSPI, SFUD Flash, SPI_WIFI)",
      "RT_USING_PIN (GPIO)",
      "RT_USING_ADC",
      "RT_USING_PWM",
      "RT_USING_RTC",
      "RT_USING_SDIO",
      "RT_USING_WDT",
      "RT_USING_HWTIMER",
      "RT_USING_USB_HOST / USB_DEVICE",
      "RT_USING_BLUETOOTH"
    ],
    "storage": [
      "BSP_USING_NOR_FLASH (QSPI)",
      "BSP_USING_NAND_FLASH",
      "RT_USING_MTD_NOR / MTD_NAND"
    ],
    "display": [
      "LCHSPI (LCD SPI 低功耗)",
      "MPI (多接口)",
      "DSI / DPI / QSPI (SF32LB58X)"
    ],
    "middleware": [
      "Bluetooth (Zephyr BLE stack)",
      "LVGL v8/v9",
      "Power Management (PM_STANDBY, PM_DEEP, PM_LIGHT)"
    ],
    "board_examples": [
      "sf32lb52-lchspi-ulp_hcpu (手表构建目标)",
      "sf32lb52-lcd_n16r8",
      "sf32lb56-lcd_a128r12n1",
      "sf32lb58-lcd_n16r64n4"
    ]
  },

  "3_key_config_files": {
    "Kconfig": [
      "sifli-sdk/rtos/Kconfig (RTOS 选择)",
      "sifli-sdk/rtos/rtthread/Kconfig",
      "sifli-sdk/rtos/rtthread/components/Kconfig",
      "sifli-sdk/rtos/rtthread/components/drivers/Kconfig",
      "sifli-sdk/rtos/rtthread/libcpu/Kconfig",
      "sifli-sdk/middleware/Kconfig"
    ],
    "rtconfig_h": [
      "sifli-sdk/tools/flash/project/sf32lb52x/src/rtconfig.h",
      "sifli-sdk/tools/flash/project/sf32lb55x_sdio/src/rtconfig.h",
      "sifli-sdk/tools/flash/project/sf32lb56x/src/rtconfig.h",
      "sifli-sdk/tools/flash/project/sf32lb58x/src/rtconfig.h",
      "sifli-sdk/example/multimedia/lvgl/watch/project/rtconfig_project.h"
    ],
    "rtconfig_py": [
      "sifli-sdk/customer/boards/sf32lb52-lchspi-ulp/hcpu/rtconfig.py",
      "sifli-sdk/customer/boards/sf32lb52-lcd_n16r8/hcpu/rtconfig.py",
      "sifli-sdk/customer/boards/eh-lb523/hcpu/rtconfig.py"
    ],
    "SConscript": [
      "sifli-sdk/SConscript (主 SDK 构建)",
      "sifli-sdk/rtos/rtthread/src/SConscript",
      "sifli-sdk/example/multimedia/lvgl/watch/project/SConscript"
    ],
    "rtconfig_py_snippet": {
      "file": "customer/boards/sf32lb52-lchspi-ulp/hcpu/rtconfig.py",
      "content": "CHIP = 'SF32LB52X'\nCORE = 'HCPU'\nTARGET_NAME = 'bf0_ap'\nJLINK_DEVICE = 'SF32LB52X_NOR'"
    }
  },

  "4_valuable_code_snippets": [
    {
      "name": "main.c - RT-Thread 入口与环境初始化",
      "file": "sifli-sdk/example/multimedia/lvgl/watch/src/app_utils/main.c",
      "snippet": "int main(void)\n{\n#ifdef SOC_BF0_LCPU\n    env_init();\n#if (NVDS_SUPPORT)\n    sifli_nvds_init();\n#endif\n#else\n    rwip_init(0);\n#endif\n#ifdef BSP_BLE_TIMEC\n    ble_tipc_init(true);\n#endif\n    return RT_EOK;\n}"
    },
    {
      "name": "DFS 挂载表示例",
      "file": "sifli-sdk/example/multimedia/lvgl/watch/src/app_utils/main.c",
      "snippet": "const struct dfs_mount_tbl mount_table[] = {\n    { .device_name = \"flash2\", .path = \"/\", .filesystemtype = \"elm\", .rwflag = 0, .data = 0 },\n    { 0 },\n};"
    },
    {
      "name": "app_clock_main - 获取当前时间",
      "file": "sifli-sdk/example/multimedia/lvgl/watch/src/gui_apps/clock/app_clock_main.c",
      "snippet": "void app_clock_main_get_current_time(app_clock_time_t *t)\n{\n    uint32_t ms;\n    rt_uint32_t cur_seconds;\n    // ... 使用 RTC 或模拟时间\n}"
    },
    {
      "name": "板级头文件与 HAL",
      "file": "example main.c",
      "includes": ["#include <rtthread.h>", "#include <rtdevice.h>", "#include <bf0_hal.h>", "#include <board.h>"]
    },
    {
      "name": "链接脚本内存区域",
      "file": "example/multimedia/lvgl/watch/project/build_sf32lb52-lchspi-ulp_hcpu/link_copy.lds",
      "snippet": "MEMORY {\n    ROM (rx) : ORIGIN = 0x12020000, LENGTH = 0x00800000\n    RAM (rw) : ORIGIN = 0x20000000, LENGTH = 0x0007FC00\n    PSRAM(rw): ORIGIN = 0x60000000, LENGTH = 0x00800000\n}"
    },
    {
      "name": "LVGL 手表 README - 字体配置",
      "file": "sifli-sdk/example/multimedia/lvgl/watch/README.md",
      "snippet": "CPPDEFINES += [\"FREETYPE_FONT_NAME={}\".format(font_name)]\n# 例如 DroidSansFallback，在 freetype 子目录查找 .ttf 转为 C 文件"
    }
  ],

  "project_structure": {
    "sifli-sdk": {
      "rtos": "RT-Thread / FreeRTOS / No-OS",
      "middleware": "bluetooth, lvgl, audio, profiler, metrics_collector",
      "external": "lvgl_v8/v9, mbedtls, tinymp3, opus, jpeg_codec, rlottie",
      "customer/boards": "各芯片+板型配置 (rtconfig.py)"
    },
    "watch_example": {
      "path": "sifli-sdk/example/multimedia/lvgl/watch/",
      "features": ["LVGL v8", "蜂窝主菜单", "表盘", "立方体旋转(非 SF32LB55X)", "eZIP 图片压缩"],
      "build_target": "sf32lb52-lchspi-ulp_hcpu"
    }
  },

  "build_system": {
    "tool": "SCons",
    "entry": "SConstruct (project 目录)",
    "rtconfig": "通过 rtconfig.CHIP 选择板型，调用 AddBootLoader/AddFTAB"
  }
}
